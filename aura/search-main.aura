;; uses: kernel.aura
;; 实验入口：算子 × 种子 × 方法（aura-random / aura-llm），结果追加到 AKB_OUT（默认 results/aura_runs.tsv）
(load-space!)
(define *ops* (string-split (env-or "AKB_OPS" "matmul,softmax,layernorm,reduce") ","))
(define *seeds* (map (lambda (s) (string->number s)) (string-split (env-or "AKB_SEEDS" "1,2,3") ",")))
(define *methods* (string-split (env-or "AKB_METHODS" "aura-random") ","))
(define *budget* (string->number (env-or "AKB_BUDGET" "16")))
(define *width* (string->number (env-or "AKB_WIDTH" "2")))
(define out (env-or "AKB_OUT" "results/aura_runs.tsv"))
(define cols (list "illegal" "dup" "illegal_random" "dup_random" "ok" "compile_error" "incorrect" "hack" "timeout" "crash" "lower-error" "aura-error" "keep" "rollback" "llm_fallback" "random_fill"))
(if (safe (lambda () (read-file out)) #f) #f
    (write-file out (string-append "op\tseed\tmethod\tstart_ms\tbest_ms\tevals\tconfirms\twall_ms\tbest_ast\t" (join-strings cols "\t") "\n")))
(for-each (lambda (op)
  (for-each (lambda (seed)
    (for-each (lambda (m)
      (let* ((dir (format "runs/~a/~a/s~a" op m seed)) (r (search! op m seed *budget* *width* dir)) (cnt (car r)))
        (append-line! out (join-strings (map (lambda (x) (format "~a" x))
          (append (list op seed m (list-ref r 6) (list-ref r 5) (cadr r) (caddr r) (list-ref r 3) (list-ref r 4))
                  (map (lambda (k) (hget cnt k 0)) cols))) "\t"))
        (write-file (string-append dir "/mutation-log.txt") (format "~a\n" (query :mutation-log)))
        (display (format "~a s~a ~a: ~a -> ~a ms (~a evals) ~a\n" op seed m (r2 (list-ref r 6)) (r2 (list-ref r 5)) (cadr r) (list-ref r 4)))))
      *methods*))
    *seeds*))
  *ops*)
(display "AKB-DONE\n")
